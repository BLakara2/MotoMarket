# ═══════════════════════════════════════════════
# MotoMarket - Variables d'environnement
# ═══════════════════════════════════════════════

# Backend
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motomarket

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# Storage (S3-compatible — Neon Object Storage / Cloudflare R2 / Backblaze B2)
AWS_ENDPOINT_URL_S3=https://<account>.storage.c-6.eu-central-1.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
STORAGE_BUCKET=assets

# Payment
PAYMENT_API_KEY=
PAYMENT_SECRET=
