# ═══════════════════════════════════════════════
# MotoMarket - Variables d'environnement
# ═══════════════════════════════════════════════

# Backend
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motomarket

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment
PAYMENT_API_KEY=
PAYMENT_SECRET=
