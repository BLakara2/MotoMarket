generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum UserRole {
  USER
  PRO
  ADMIN
}

enum SellerType {
  INDIVIDUAL
  PROFESSIONAL
}

enum MotorcycleStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  PAUSED
  EXPIRED
  REJECTED
  DELETED
}

enum MotorcycleType {
  CROSS
  ROUTE
  ROADSTER
  SCOOTER
  TRAIL
  CUSTOM
  AUTRE
}

enum FuelType {
  ESSENCE
  DIELECTRIQUE
  HYBRIDE
  ELECTRIQUE
}

enum TransmissionType {
  MANUELLE
  AUTOMATIQUE
  SEMI_AUTO
}

enum ConditionType {
  NEUF
  TRES_BON
  BON
  USAGE
  A_REFORMER
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  VERIFIED
  REJECTED
}

enum ReportReason {
  FRAUD
  FAKE_LISTING
  MISLEADING_PRICE
  NON_EXISTENT
  SUSPICIOUS_SELLER
  FORBIDDEN_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReviewStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  BOOST
  SUBSCRIPTION
}

enum BoostStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ═══════════════════════════════════════════════
// TABLES
// ═══════════════════════════════════════════════

model User {
  id               String           @id @default(uuid())
  firstName        String           @map("first_name") @db.VarChar(50)
  lastName         String           @map("last_name") @db.VarChar(50)
  email            String           @unique @db.VarChar(255)
  phone            String?          @db.VarChar(20)
  passwordHash     String           @map("password_hash")
  role             UserRole         @default(USER)
  avatar           String?
  isPhoneVerified  Boolean          @default(false) @map("is_phone_verified")
  isEmailVerified  Boolean          @default(false) @map("is_email_verified")
  isVerifiedSeller Boolean          @default(false) @map("is_verified_seller")
  verificationStatus VerificationStatus @default(NOT_REQUESTED) @map("verification_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  sellerProfile    SellerProfile?
  motorcycles      Motorcycle[]
  favorites        Favorite[]
  sentMessages     Message[]        @relation("SentMessages")
  conversations    Conversation[]   @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  reviewsGiven     Review[]         @relation("ReviewReviewer")
  reviewsReceived  Review[]         @relation("ReviewSeller")
  reports          Report[]
  payments         Payment[]
  boosts           Boost[]
  subscriptions    Subscription[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SellerProfile {
  id           String       @id @default(uuid())
  userId       String       @unique @map("user_id")
  type         SellerType   @default(INDIVIDUAL)
  businessName String?      @map("business_name") @db.VarChar(100)
  description  String?      @db.Text
  logo         String?
  city         String       @db.VarChar(100)
  district     String?      @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")

  models MotorcycleModel[]
  motorcycles Motorcycle[]

  @@map("brands")
}

model MotorcycleModel {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  motorcycles Motorcycle[]

  @@unique([brandId, name])
  @@map("motorcycle_models")
}

model Category {
  id    String @id @default(uuid())
  name  String @unique @db.VarChar(100)
  slug  String @unique @db.VarChar(100)

  motorcycles Motorcycle[]

  @@map("categories")
}

model Motorcycle {
  id              String           @id @default(uuid())
  sellerId        String           @map("seller_id")
  brandId         String           @map("brand_id")
  modelId         String           @map("model_id")
  categoryId      String?          @map("category_id")
  title           String           @db.VarChar(100)
  description     String           @db.Text
  price           Int
  isPriceNegotiable Boolean        @default(false) @map("is_price_negotiable")
  year            Int
  mileage         Int
  engineCc        Int              @map("engine_cc")
  type            MotorcycleType
  fuel            FuelType
  transmission    TransmissionType
  condition       ConditionType
  city            String           @db.VarChar(100)
  district        String?          @db.VarChar(100)
  status          MotorcycleStatus @default(DRAFT)
  isFeatured      Boolean          @default(false) @map("is_featured")
  publishedAt     DateTime?        @map("published_at")
  expiresAt       DateTime?        @map("expires_at")
  maintenanceInfo String?          @db.Text @map("maintenance_info")
  papersInfo      String?          @db.Text @map("papers_info")
  modifications   String?          @db.Text
  viewsCount      Int              @default(0) @map("views_count")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  seller       User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brand        Brand             @relation(fields: [brandId], references: [id])
  model        MotorcycleModel   @relation(fields: [modelId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id])
  images       MotorcycleImage[]
  favorites    Favorite[]
  reviews      Review[]
  reports      Report[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([brandId])
  @@index([modelId])
  @@index([status])
  @@index([city])
  @@index([price])
  @@index([createdAt])
  @@map("motorcycles")
}

model MotorcycleImage {
  id           String   @id @default(uuid())
  motorcycleId String   @map("motorcycle_id")
  url          String
  position     Int      @default(0)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@index([motorcycleId])
  @@map("motorcycle_images")
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  motorcycleId String   @map("motorcycle_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@unique([userId, motorcycleId])
  @@map("favorites")
}

model Conversation {
  id           String    @id @default(uuid())
  motorcycleId String    @map("motorcycle_id")
  buyerId      String    @map("buyer_id")
  sellerId     String    @map("seller_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  buyer      User       @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller     User       @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([motorcycleId, buyerId, sellerId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Review {
  id           String       @id @default(uuid())
  reviewerId   String       @map("reviewer_id")
  sellerId     String       @map("seller_id")
  motorcycleId String?      @map("motorcycle_id")
  rating       Int
  comment      String?      @db.Text
  status       ReviewStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")

  reviewer   User        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller     User        @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle? @relation(fields: [motorcycleId], references: [id])

  @@unique([reviewerId, motorcycleId])
  @@map("reviews")
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String       @map("reporter_id")
  motorcycleId String       @map("motorcycle_id")
  reason       ReportReason
  description  String?      @db.Text
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  resolvedAt   DateTime?    @map("resolved_at")

  reporter   User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model BoostPlan {
  id           String @id @default(uuid())
  name         String @db.VarChar(50)
  durationDays Int    @map("duration_days")
  price        Int
  isActive     Boolean @default(true) @map("is_active")

  boosts Boost[]

  @@map("boost_plans")
}

model Boost {
  id           String     @id @default(uuid())
  motorcycleId String     @map("motorcycle_id")
  userId       String     @map("user_id")
  planId       String     @map("plan_id")
  startsAt     DateTime   @map("starts_at")
  endsAt       DateTime   @map("ends_at")
  status       BoostStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       BoostPlan  @relation(fields: [planId], references: [id])

  @@map("boosts")
}

model SubscriptionPlan {
  id                String @id @default(uuid())
  name              String @db.VarChar(50)
  price             Int
  durationDays      Int    @map("duration_days")
  maxActiveListings Int    @map("max_active_listings")
  maxBoosts         Int    @map("max_boosts")
  features          String[]
  isActive          Boolean @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  planId    String             @map("plan_id")
  startsAt  DateTime           @map("starts_at")
  endsAt    DateTime           @map("ends_at")
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  type              PaymentType
  amount            Int
  currency          String        @default("MGA") @db.VarChar(3)
  provider          String?       @db.VarChar(50)
  providerReference String?       @map("provider_reference") @db.VarChar(255)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}
